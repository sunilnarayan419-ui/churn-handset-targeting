# Copy to .env (never commit .env)
DATA_DIR=data/raw
MODEL_PATH=models/churn_model.joblib
BASE_RATE=0.0099          # assumed monthly churn rate used to rescale probabilities
API_KEY=                  # set to require an X-API-Key header on the API (health stays open)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j
